format = "simucraft.model/0.1"
id = "m_000000000005"
name = "pid_plant"
doc = "Gate G1 model: continuous PID (parallel form) around 2 / (0.5 s + 1). Same model as `pid_plant` in conformance/matlab/export_references.m."

[blocks.b_050000000001]
name = "ref"
type = "core.Step"

[blocks.b_050000000001.params]
time = 0.1
initial = 0.0
final = 1.0

[blocks.b_050000000002]
name = "err"
type = "core.Sum"

[blocks.b_050000000002.params]
signs = "+-"

[blocks.b_050000000002.inputs]
u1 = "b_050000000001.y"
u2 = "b_050000000004.y"

[blocks.b_050000000003]
name = "pid"
type = "core.PID"

[blocks.b_050000000003.params]
P = 2.0
I = 5.0
D = 0.1
N = 100.0

[blocks.b_050000000003.inputs]
u = "b_050000000002.y"

[blocks.b_050000000004]
name = "plant"
type = "core.TransferFcn"

[blocks.b_050000000004.params]
num = [2.0]
den = [0.5, 1.0]

[blocks.b_050000000004.inputs]
u = "b_050000000003.y"

[blocks.b_050000000005]
name = "y"
type = "core.Outport"

[blocks.b_050000000005.inputs]
u = "b_050000000004.y"

[blocks.b_050000000006]
name = "u"
type = "core.Outport"

[blocks.b_050000000006.inputs]
u = "b_050000000003.y"
