{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimuCraft",
  "version": "0.0.1",
  "identifier": "org.simucraft.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SimuCraft", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
